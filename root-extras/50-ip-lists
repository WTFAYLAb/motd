#!/usr/bin/env bash

## Set function
insert_comma() {
	awk '{ printf "%\047d\n", $1 }'
}

## Get Fail2Ban counts
mapfile -t F2B_CurBannedIPs < <(
	ufw status | grep Fail2Ban | awk '{ print $3 }'
)
mapfile -t F2B_CurBannedIPsFiltered < <(
	printf "%s\n" "${F2B_CurBannedIPs[@]}" | grep -v '/'
)
F2B_CurBannedIPCountComma=$(
	printf "%s" ${#F2B_CurBannedIPsFiltered} | insert_comma
)
F2B_CurBannedCIDRCount=$((${#F2B_CurBannedIPs}-${#F2B_CurBannedIPsFiltered}))
F2B_CurBannedCIDRCountComma=$(
	printf "%s" "${F2B_CurBannedCIDRCount}" | insert_comma
)

## Get Helix Hall Of Fame counts
mapfile -t HHOF_IPs < <(
	ufw status | grep HHoF | awk '{ print $3 }'
)
mapfile -t HHOF_IPsFiltered < <(
	printf "%s\n" "${HHOF_IPs[@]}" | grep -v '/'
)
HHOF_IPCountComma=$(
	printf "%s" ${#HHOF_IPsFiltered} | insert_comma
)
HHOF_CIDRCount=$((${#HHOF_IPs}-${#HHOF_IPsFiltered}))
HHOF_CIDRCountComma=$(
	printf "%s" ${#HHOF_CIDRCount} | insert_comma
)

## Get Whitelist counts
mapfile -t WhtlstIPs < <(
	showwhitelist | grep -vE '^\s*$|^\s*#|127\.'
)
mapfile -t WhtlstIPsFiltered < <(
	printf "%s\n" "${WhtlstIPs[@]}" | grep -v '/'
)
WhtlistCIDRCount=$(( ${#WhtlstIPs} - ${#WhtlstIPsFiltered} ))
WhitlistIPCountComma=$(
	printf "%s" "${#WhtlstIPs}" | insert_comma
)
WhitlistCIDRCountComma=$(
	printf "%s" "${#WhtlistCIDRCount}" | insert_comma
)

## Set colors
ClrRed=$(tput setaf 196)
ClrGrn=$(tput setaf 46)
ClrOff=$(tput sgr0)

## Display
printf "\ncurrently banned:\n"
printf "%-20s${ClrRed}%-10s${ClrOff} %-20s${ClrRed}%-10s${ClrOff}\n" \
	"  Fail2Ban IPs......:" " ${F2B_CurBannedIPCountComma}" \
	"Fail2Ban CIDR......:" " ${F2B_CurBannedCIDRCountComma}"
printf "%-20s${ClrRed}%-10s${ClrOff} %-20s${ClrRed}%-10s${ClrOff}\n" \
	"  Hall of Fame IPs..:" " ${HHOF_IPCountComma}" \
	"Hall of Fame CIDR..:" " ${HHOF_CIDRCountComma}"

printf "\ncurrently whitelisted:\n"
printf "%-20s${ClrGrn}%-10s${ClrOff} %-20s${ClrGrn}%-10s${ClrOff}\n" \
	"  Whitelisted IPs...:" " ${WhitlistIPCountComma}" \
	"Whitelisted CIDR...:" " ${WhitlistCIDRCountComma}"
