#!/usr/bin/env bash

BanCounts=$(mktemp)
/usr/local/sbin/showbancounts > "$BanCounts"
F2B_BannedIPCount=$(awk 'NR==5' "$BanCounts")
F2B_BannedCIDRCount=$(awk 'NR==8' "$BanCounts")
HHOF_IPCount=$(awk 'NR==20' "$BanCounts")
HHOF_CIDRCount=$(awk 'NR==23' "$BanCounts")
TotalIPCount=$(awk 'NR==35' "$BanCounts")
TotalCIDR_Count=$(awk 'NR==38' "$BanCounts")
ExpCIDR_Count=$(awk 'NR==41' "$BanCounts")
GrandTotalIP_Count=$(awk 'NR==44' "$BanCounts")

## Get Whitelist counts (one pass: same filters as grep -vE + slash = CIDR)
read -r WhitlistIPCount WhitlistCIDRCount < <(
	showwhitelist 2>/dev/null | awk '
		/^[[:space:]]*$/ { next }
		/^[[:space:]]*#/ { next }
		/127\./ { next }
		{
			n++
			line = $0
			sub(/\r$/, "", line)
			if (line ~ /\//) c++
		}
		END { print (n - c) + 0, c + 0 }
	'
)
: "${WhitlistIPCount:=0}"
: "${WhitlistCIDRCount:=0}"

## Set colors
ClrBlu=$(tput setaf 45)
ClrOff=$(tput sgr0)

color_range() {
	if [[ Count -eq 0 ]]; then
		ClrRng=82
	elif (( Count >= 1 && Count <= 100 )); then
		ClrRng=154
	elif (( Count >= 101 && Count <= 200 )); then
		ClrRng=184
	elif (( Count >= 201 && Count <= 300 )); then
		ClrRng=190
	elif (( Count >= 301 && Count <= 400 )); then
		ClrRng=226
	elif (( Count >= 401 && Count <= 500 )); then
		ClrRng=220
	elif (( Count >= 501 && Count <= 600 )); then
		ClrRng=214
	elif (( Count >= 601 && Count <= 700 )); then
		ClrRng=208
	elif (( Count >= 701 && Count <= 800 )); then
		ClrRng=202
	elif (( Count >= 801 && Count <= 900 )); then
		ClrRng=160
	elif (( Count >= 901 )); then
		ClrRng=196
	fi
}

insert_comma() {
	[[ Count -gt 999 ]] && Count=$(
		echo "$Count" | awk '{ printf "%\047d\n", $1 }'
	)
}

## Display Whitelist Counts
printf "\ncurrently whitelisted:\n"
printf "%-20s${ClrBlu}%-10s${ClrOff} %-20s${ClrBlu}%-10s${ClrOff}\n" \
	"  Whitelisted IPs...:" " $WhitlistIPCount" \
	"Whitelisted CIDR...:" " $WhitlistCIDRCount"

## Display Fail2Ban Counts
printf "\ncurrently banned:\n"
Count=$F2B_BannedIPCount
color_range
SetClrRange=$(tput setaf "$ClrRng")
insert_comma
printf "%-20s${SetClrRange}%-10s${ClrOff} " \
	"  Fail2Ban IPs......:" " $Count"

Count=$F2B_BannedCIDRCount
color_range
SetClrRange=$(tput setaf "$ClrRng")
insert_comma
printf "%-20s${SetClrRange}%-10s${ClrOff}\n" \
	"Fail2Ban CIDR......:" " $Count"

## Display Helix Hall of Fame Counts
Count=$HHOF_IPCount
color_range
SetClrRange=$(tput setaf "$ClrRng")
insert_comma
printf "%-20s${SetClrRange}%-10s${ClrOff} " \
	"  Hall of Fame IPs..:" " $Count"

Count=$HHOF_CIDRCount
color_range
SetClrRange=$(tput setaf "$ClrRng")
insert_comma
printf "%-20s${SetClrRange}%-10s${ClrOff}\n\n" \
	"Hall of Fame CIDR..:" " $Count"

Count=$TotalIPCount
color_range
SetClrRange=$(tput setaf "$ClrRng")
insert_comma
printf "%-20s${SetClrRange}%-10s${ClrOff} " \
	"  Total Single IPs..:" " $Count"

Count=$TotalCIDR_Count
color_range
SetClrRange=$(tput setaf "$ClrRng")
insert_comma
printf "%-20s${SetClrRange}%-10s${ClrOff}\n" \
	"Total CIDR.........:" " $Count"

Count=$ExpCIDR_Count
color_range
SetClrRange=$(tput setaf "$ClrRng")
insert_comma
printf "%-20s${SetClrRange}%-10s${ClrOff} " \
	"  Expanded CIDR IPs.:" " $Count"

Count=$GrandTotalIP_Count
color_range
SetClrRange=$(tput setaf "$ClrRng")
insert_comma
printf "%-20s${SetClrRange}%-10s${ClrOff}\n" \
	"Grand Total IPs....:" " $Count"
