#!/usr/bin/env bash

## Set function
insert_comma() {
	awk '{ printf "%\047d\n", $1 }'
}

## ufw for MOTD: PATH is often minimal; avoid two-stage mapfile + printf "${arr[@]}"
## (huge argv, IFS/glob differences vs manual HHOF_IPs=( $(...) ), and impossible CIDR>IP mismatches).
_UFW=$(command -v ufw 2>/dev/null) || true
[[ -z $_UFW && -x /usr/sbin/ufw ]] && _UFW=/usr/sbin/ufw
[[ -z $_UFW && -x /sbin/ufw ]] && _UFW=/sbin/ufw
_UFW=${_UFW:-ufw}

## Get Fail2Ban counts (one pass: same as grep + awk $3 + count / in $3)
read -r F2B_BannedIPCount F2B_BannedCIDRCount < <(
	COLUMNS="${COLUMNS:-320}" "$_UFW" status 2>/dev/null | awk '
		/Fail2Ban/ {
			n++
			ip = $3
			sub(/\r$/, "", ip)
			if (ip ~ /\//) c++
		}
		END { print (n - c) + 0, c + 0 }
	'
)
: "${F2B_BannedIPCount:=0}"
: "${F2B_BannedCIDRCount:=0}"
[[ $F2B_BannedIPCount -gt 999 ]] && F2B_BannedIPCount=$(
	echo "$F2B_BannedIPCount" | insert_comma
)
[[ $F2B_BannedCIDRCount -gt 999 ]] && F2B_BannedCIDRCount=$(
	echo "$F2B_BannedCIDRCount" | insert_comma
)

## Get Helix Hall Of Fame counts
read -r HHOF_IPCount HHOF_CIDRCount < <(
	COLUMNS="${COLUMNS:-320}" "$_UFW" status 2>/dev/null | awk '
		/HHoF/ {
			n++
			ip = $3
			sub(/\r$/, "", ip)
			if (ip ~ /\//) c++
		}
		END { print (n - c) + 0, c + 0 }
	'
)
: "${HHOF_IPCount:=0}"
: "${HHOF_CIDRCount:=0}"
[[ $HHOF_IPCount -gt 999 ]] && HHOF_IPCount=$(
	echo "$HHOF_IPCount" | insert_comma
)
[[ $HHOF_CIDRCount -gt 999 ]] && HHOF_CIDRCount=$(
	echo "$HHOF_CIDRCount" | insert_comma
)

## Get Whitelist counts
mapfile -t WhtlstIPs < <(
	showwhitelist | grep -vE '^\s*$|^\s*#|127\.'
)
mapfile -t WhtlstIPsCIDR < <(
	printf "%s\n" "${WhtlstIPs[@]}" | grep -e '/'
)
WhitlistIPCount=$(( ${#WhtlstIPs} - ${#WhtlstIPsCIDR} ))
[[ $WhitlistIPCount -gt 999 ]] && WhitlistIPCount=$(
	echo $WhitlistIPCount | insert_comma
)
if [[ ${#WhtlstIPsCIDR} -gt 999 ]]; then
	WhitlistCIDRCount=$(
		echo "${#WhtlstIPsCIDR}" | insert_comma
	)
else
	WhitlistCIDRCount="${#WhtlstIPsCIDR}"
fi

## Set colors
ClrRed=$(tput setaf 196)
ClrGrn=$(tput setaf 46)
ClrOff=$(tput sgr0)

## Display
printf "\ncurrently banned:\n"
printf "%-20s${ClrRed}%-10s${ClrOff} %-20s${ClrRed}%-10s${ClrOff}\n" \
	"  Fail2Ban IPs......:" " $F2B_BannedIPCount" \
	"Fail2Ban CIDR......:" " $F2B_BannedCIDRCount"
printf "%-20s${ClrRed}%-10s${ClrOff} %-20s${ClrRed}%-10s${ClrOff}\n" \
	"  Hall of Fame IPs..:" " $HHOF_IPCount" \
	"Hall of Fame CIDR..:" " $HHOF_CIDRCount"

printf "\ncurrently whitelisted:\n"
printf "%-20s${ClrGrn}%-10s${ClrOff} %-20s${ClrGrn}%-10s${ClrOff}\n" \
	"  Whitelisted IPs...:" " $WhitlistIPCount" \
	"Whitelisted CIDR...:" " $WhitlistCIDRCount"